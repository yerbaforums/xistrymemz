# ──────────────────────────────────────────────────────────────────────────────
# XistrYmemZ — environment template. Copy to .env and fill in the blanks.
# Placeholders only: no real secrets live in this file.
# Only DATABASE_URL and NEXTAUTH_SECRET are required to boot.
# ──────────────────────────────────────────────────────────────────────────────

# ── Required ───────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Neon or any Postgres-compatible host).
DATABASE_URL="postgresql://user:password@localhost:5432/xistrymemz"
# NextAuth session signing secret. Generate one with: openssl rand -base64 32
NEXTAUTH_SECRET="generate-with-openssl-rand-base64-32"
# Canonical origin — used for auth callbacks, email links, feeds, federation, CORS.
NEXTAUTH_URL="http://localhost:3000"

# ── Admin bootstrap ────────────────────────────────────────────────────────────
# Comma-separated emails granted admin on sign-in (names optional).
ADMIN_EMAILS=""
ADMIN_NAMES=""

# ── OAuth providers ────────────────────────────────────────────────────────────
# Each provider is registered only when BOTH its id and secret are set.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""
DISCORD_CLIENT_ID=""
DISCORD_CLIENT_SECRET=""
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
FACEBOOK_CLIENT_ID=""
FACEBOOK_CLIENT_SECRET=""

# ── IPFS & media ───────────────────────────────────────────────────────────────
# Pinata credentials. Required for durable backup pins and IPFS media uploads —
# without them, backups fall back to local-only storage.
PINATA_API_KEY=""
PINATA_SECRET_API_KEY=""
# Public gateway used for CID downloads and media links.
IPFS_GATEWAY="https://gateway.pinata.cloud"
# Optional: HTTP API of a local IPFS node used to pin media when self-hosting.
IPFS_API_URL="http://127.0.0.1:5001"

# ── Backups ────────────────────────────────────────────────────────────────────
# Required for backups. Dumps are encrypted (AES-256-GCM) before they
# touch disk or IPFS — a leaked CID only exposes ciphertext. If unset,
# backups refuse to run rather than write plaintext. Generate with:
#   openssl rand -base64 32
BACKUP_ENCRYPTION_KEY="generate-with-openssl-rand-base64-32"
# Optional: pin backups to your own IPFS node (kubo RPC URL, e.g.
# http://127.0.0.1:5001) instead of Pinata — decentralized durability
# without a third party.
IPFS_PIN_URL=""

# ── Email (Resend) ─────────────────────────────────────────────────────────────
RESEND_API_KEY=""
EMAIL_FROM="noreply@xistrymemz.xyz"

# ── Translation ────────────────────────────────────────────────────────────────
# DeepL API key for machine translation of missing locales.
DEEPL_API_KEY=""

# ── Cron ───────────────────────────────────────────────────────────────────────
# Bearer token that authorizes /api/cron/* routes (federation delivery,
# sponsorship reminders, backup jobs). Keep in sync with your cron provider.
CRON_SECRET=""

# ── Limits ─────────────────────────────────────────────────────────────────────
# Maximum uploaded video length in seconds (default: 15 minutes).
NEXT_PUBLIC_MAX_VIDEO_DURATION_SEC=900

# ── Maps ───────────────────────────────────────────────────────────────────────
# Free CARTO basemaps key (request at carto.com/basemaps/apikey). Appended to
# dark-mode tile URLs as ?key=. Client-side by necessity — restrict by HTTP
# referrer in the CARTO dashboard.
NEXT_PUBLIC_CARTO_KEY=""

# ── Maps ───────────────────────────────────────────────────────────────────────
# Free CARTO basemaps key (request at carto.com/basemaps/apikey). Appended to
# dark-mode tile URLs as ?key=. Client-side by necessity — restrict by HTTP
# referrer in the CARTO dashboard.
NEXT_PUBLIC_CARTO_KEY=""

# CARTO basemaps API base URL. Default is CARTO's US East region; CARTO may
# assign you a different regional endpoint.
NEXT_PUBLIC_CARTO_API_BASE_URL="https://gcp-us-east1.api.carto.com"
